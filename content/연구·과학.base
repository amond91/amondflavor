# 📂 분류 페이지 — 좌측 메뉴(Explorer)의 「분류」 아래에 보인다. 🔴 분류 이름은 MBX PIN_CATEGORIES 와 같아야 한다.
filters:
  and:
    - file.inFolder("posts")
    - category == "연구·과학"
properties:
  description:
    displayName: 요약
  date:
    displayName: 날짜
views:
  - type: cards
    name: 연구·과학
    order: [description, date]
    sort:
      - property: date
        direction: DESC
