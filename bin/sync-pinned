#!/usr/bin/env python3
"""MBX 📌 Pin 요약 노트 → Quartz content/posts/ 로 공개용 글을 만든다.

원본(MBX_digests/pinned/)은 읽기만 한다. content/posts/ 는 매번 통째로 다시 만든다.

공개 규칙 (2026-10-22 amond: 메일 뉴스레터도 싣는다)
  - 기본: 전부 싣는다. 원본 노트 frontmatter 에 `publish: false` 가 있으면 싣지 않는다.
  - 메일 출처(PUBLIC_SOURCES 밖)는 계정 이름 대신 「뉴스레터」로 보이고 메일 링크가 빠진다.
  - 주입 의심(`injection: true`) 노트는 싣지 않는다.
  - 「수집 때 요약」(원문 발췌)과 메일 링크는 빼고 싣는다.

사용:
  bin/sync-pinned [--src DIR] [--dry-run]
"""
import argparse
import json
import os
import re
import shutil
import sys
import unicodedata
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT / "content" / "posts"
DEFAULT_SRC = Path(os.environ.get("PIN_SRC", Path.home() / "MyProjects/MBX_digests/pinned"))

PUBLIC_SOURCES = {"GeekNews"}
PRIVATE_SOURCE_LABEL = "뉴스레터"  # 메일 출처는 계정 이름 대신 이것으로 보인다
DROP_SECTIONS = {"수집 때 요약"}
RENAME_SECTIONS = {"내 관심사와 닿는 점": "왜 골랐나"}


def split_frontmatter(text):
    if not text.startswith("---\n"):
        return {}, text
    end = text.find("\n---\n", 4)
    if end < 0:
        return {}, text
    meta = {}
    for line in text[4:end].splitlines():
        if ":" not in line:
            continue
        k, v = line.split(":", 1)
        v = v.strip()
        try:
            meta[k.strip()] = json.loads(v)
        except ValueError:
            meta[k.strip()] = v
    return meta, text[end + 5:]


def decide(meta):
    """싣는지와 그 이유."""
    if meta.get("publish") is False:
        return False, "publish: false"
    if meta.get("injection") is True:
        return False, "주입 의심"
    return True, "싣는다"


def transform_body(body, is_public_source):
    out, skipping = [], False
    for line in body.splitlines():
        if line.startswith("# "):  # 제목은 Quartz 가 frontmatter 로 그린다
            continue
        if line.startswith("## "):
            name = line[3:].strip()
            skipping = name in DROP_SECTIONS
            if not skipping and name in RENAME_SECTIONS:
                line = "## " + RENAME_SECTIONS[name]
        if skipping:
            continue
        if line.startswith("> 📌"):
            line = header_line(line, is_public_source)
        out.append(line)
    return "\n".join(out).strip() + "\n"


def header_line(line, is_public_source):
    """`> 📌 날짜 · 출처 · [원문 보기](...) · [원문 기사](...)` 에서 메일 링크와 계정 이름을 뺀다."""
    if is_public_source:
        return line
    parts = line[len("> 📌"):].split(" · ")
    if len(parts) > 1:
        parts[1] = PRIVATE_SOURCE_LABEL
    parts = [p for p in parts if "mail.google.com" not in p]
    return "> 📌" + " · ".join(parts)


def out_name(name, used, limit=100):
    """NFC 로 바꾸고 바이트 기준으로 자른다. macOS 파일명은 NFD 라 한글 제목이 리눅스 상한(255바이트)을 넘는다."""
    stem = unicodedata.normalize("NFC", name[:-3])
    while len(stem.encode()) > limit:
        stem = stem[:-1]
    stem, n = stem.rstrip("-"), 2
    cand = stem
    while cand in used:
        cand, n = f"{stem}-{n}", n + 1
    used.add(cand)
    return cand + ".md"


def tag(word):
    return re.sub(r"\s+", "-", unicodedata.normalize("NFC", word.strip()))


def render(meta, body):
    is_public = meta.get("source") in PUBLIC_SOURCES
    fm = {
        "title": meta.get("title", ""),
        "date": str(meta.get("received", ""))[:10],
        "description": first_tldr(body),
        "category": meta.get("category") or "미분류",
        "tags": [tag(k) for k in meta.get("keywords", [])],
        "source": meta.get("source", "") if is_public else PRIVATE_SOURCE_LABEL,
    }
    if is_public and meta.get("link"):
        fm["link"] = meta["link"]
    if meta.get("original"):
        fm["original"] = meta["original"]
    if meta.get("coverage"):
        fm["coverage"] = str(meta["coverage"]).split(" ")[0]
    head = "---\n" + "".join(f"{k}: {json.dumps(v, ensure_ascii=False)}\n" for k, v in fm.items()) + "---\n\n"
    return head + transform_body(body, is_public)


def first_tldr(body):
    m = re.search(r"^## 한 줄 요약\n+(.+?)\n", body, re.M)
    return re.sub(r"==|\*\*", "", m.group(1)).strip() if m else ""


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--src", type=Path, default=DEFAULT_SRC)
    ap.add_argument("--dry-run", action="store_true", help="쓰지 않고 판정만 보여 준다")
    args = ap.parse_args()

    if not args.src.is_dir():
        sys.exit(f"원본 폴더가 없다: {args.src}")

    picked, skipped = [], {}
    for path in sorted(args.src.glob("*.md")):
        meta, body = split_frontmatter(path.read_text(encoding="utf-8"))
        ok, why = decide(meta)
        if ok:
            picked.append((path, meta, body))
        else:
            skipped[why] = skipped.get(why, 0) + 1

    print(f"싣는다 {len(picked)}건 · 뺀다 {sum(skipped.values())}건")
    for why, n in sorted(skipped.items(), key=lambda x: -x[1]):
        print(f"  · {why}: {n}")
    if args.dry_run:
        return

    if OUT.exists():
        shutil.rmtree(OUT)
    OUT.mkdir(parents=True)
    used = set()
    for path, meta, body in picked:
        (OUT / out_name(path.name, used)).write_text(render(meta, body), encoding="utf-8")
    print(f"→ {OUT.relative_to(ROOT)}/")


if __name__ == "__main__":
    main()
